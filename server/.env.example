# MyMusic sunucu ayarlari. Kopyala: cp .env.example .env  (sonra chmod 600 .env)
# Gercek degerleri ASLA repoya koyma.

# Sahip sifresi (uygulamada Ayarlar > Bulut'ta girilir). Guclu bir sifre sec.
OWNER_PASSWORD=change-me

# Paylasim/medya linklerini imzalar. Uret: openssl rand -base64 32
SIGNING_SECRET=change-me-to-a-long-random-string

# Disaridan erisilen adres (paylasim linkleri bununla olusur). Sonunda / olmasin.
PUBLIC_URL=https://music.emiraksu.me

# Istege bagli (varsayilanlar asagidaki gibidir; degistirmek istemezsen satirlari kapali tut):
# ALLOWED_ORIGINS=https://overflow-sudo.github.io,http://localhost:5173,http://localhost:5174
# MAX_UPLOAD_BYTES=4294967296
